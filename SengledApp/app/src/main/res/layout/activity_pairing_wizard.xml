<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_dark"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/pairing_title"
        app:titleTextColor="@color/text_primary" />

    <!-- Step indicator -->
    <LinearLayout
        android:id="@+id/stepIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp">

        <View
            android:id="@+id/step1Dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/step_dot_active" />

        <View
            android:id="@+id/step2Dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/step_dot_inactive" />

        <View
            android:id="@+id/step3Dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/step_dot_inactive" />

        <View
            android:id="@+id/step4Dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/step_dot_inactive" />
    </LinearLayout>

    <!-- Step content area -->
    <FrameLayout
        android:id="@+id/stepContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/pairing_next"
        app:backgroundTint="@color/amber_primary"
        app:cornerRadius="12dp"
        android:textColor="@color/black"
        android:textSize="16sp" />

</LinearLayout>
