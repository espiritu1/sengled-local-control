<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <!-- Section: How it works -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_how"
        android:textColor="@color/icon_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_how_text"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- Section: Routines -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_routines"
        android:textColor="@color/icon_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_routines_text"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- Section: Router configuration -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_router"
        android:textColor="@color/icon_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_router_text"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- Section: Why 2.4 GHz -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_wifi"
        android:textColor="@color/icon_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_wifi_text"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- Section: Contact -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_contact"
        android:textColor="@color/icon_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_section_contact_text"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:autoLink="email|web"
        android:linksClickable="true"
        android:layout_marginBottom="8dp" />

    <!-- Disclaimer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_disclaimer"
        android:textColor="#888888"
        android:textSize="12sp"
        android:autoLink="web"
        android:linksClickable="true"
        android:layout_marginBottom="8dp" />

</LinearLayout>
