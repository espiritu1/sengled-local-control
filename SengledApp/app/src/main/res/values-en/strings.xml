    <string name="info_btn_switch">Switch — Turn the bulb on or off</string>
    <string name="info_btn_brightness">Brightness — Adjust the light intensity</string>

    <string name="info_disclaimer">⚠ This application is NOT affiliated with or official Sengled.\n\nThe Android app was independently developed. The UDP communication protocol is based on documentation from the community project &lt;a href="https://github.com/HamzaETTH/SengledTools"&gt;HamzaETTH/SengledTools&lt;/a&gt; on GitHub, allowing the bulbs to work locally without relying on external servers.</string>

